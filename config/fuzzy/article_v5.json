{
  "id": "article_v5",
  "name": "Статья v5: 6 показателей, 12 правил",
  "description": "Нормирование (табл. 1), термы Н/С/В — разбиение Руспини, выходные термы ОН…ОВ на [0, 10], база правил (табл. 2). R1–R5 — исходные экспертные суждения, R6–R12 обеспечивают полноту.",
  "k": 2,
  "variables": [
    {"key": "acc", "name": "Точность", "unit": "%", "L": 40, "U": 90, "dir": 1,
     "labels": {"Н": "низкая", "С": "средняя", "В": "высокая"}},
    {"key": "lat", "name": "Время отклика", "unit": "с", "L": 1, "U": 6, "dir": -1,
     "labels": {"Н": "большое", "С": "среднее", "В": "малое"}},
    {"key": "tox", "name": "Токсичность", "unit": "%", "L": 0, "U": 25, "dir": -1,
     "labels": {"Н": "высокая", "С": "средняя", "В": "низкая"}},
    {"key": "rob", "name": "Устойчивость", "unit": "%", "L": 40, "U": 90, "dir": 1,
     "labels": {"Н": "низкая", "С": "средняя", "В": "высокая"}},
    {"key": "bias", "name": "Предвзятость", "unit": "индекс", "L": 10, "U": 60, "dir": -1,
     "labels": {"Н": "высокая", "С": "средняя", "В": "низкая"}},
    {"key": "res", "name": "Потребление ресурсов", "unit": "% памяти", "L": 15, "U": 90, "dir": -1,
     "labels": {"Н": "высокое", "С": "среднее", "В": "низкое"}}
  ],
  "in_terms": {"Н": [0, 0, 0.2, 0.5], "С": [0.2, 0.5, 0.5, 0.8], "В": [0.5, 0.8, 1, 1]},
  "out_terms": {"ОН": [-2.5, 0, 0, 2.5], "Н": [0, 2.5, 2.5, 5], "С": [2.5, 5, 5, 7.5],
                "В": [5, 7.5, 7.5, 10], "ОВ": [7.5, 10, 10, 12.5]},
  "rules": [
    "R1: acc=В И lat=В И tox=В И rob=В И bias=В И НЕ res=Н -> ОВ",
    "R2: acc=С И lat=В И tox=В -> В",
    "R3: acc=Н ИЛИ rob=Н -> Н",
    "R4: lat=Н И НЕ acc=В -> Н",
    "R5: tox=Н ИЛИ bias=Н -> ОН",
    "R6: acc=В И rob=В -> В",
    "R7: acc=В И rob=С -> В",
    "R8: acc=С И rob=В -> С",
    "R9: acc=С И rob=С -> С",
    "R10: res=Н И НЕ acc=В -> Н",
    "R11: lat=Н И acc=В -> С",
    "R12: res=Н И acc=В -> С"
  ]
}
